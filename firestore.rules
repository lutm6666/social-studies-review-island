rules_version = '2';
// 社會科複習島排行榜：任何人可讀；只能寫自己的那一筆，且格式、分數範圍、更新頻率都有限制
service cloud.firestore {
  match /databases/{database}/documents {
    match /lb/{board}/players/{uid} {
      allow read: if board == 'all' || board.matches('w[0-9]+');
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (board == 'all' || board.matches('w[0-9]+'))
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 4000
        && request.resource.data.at == request.time
        && (resource == null || request.time > resource.data.at + duration.value(5, 's'));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
